# Copy this file to .env and fill it in. NEVER commit .env.

PORT=3000

# --- Email (Gmail example: enable 2-step verification, then create an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=nifrah590@gmail.com
SMTP_PASS=your-16-char-app-password
CONTACT_TO=nifrah590@gmail.com

# --- Chatbot LLM (use ONE; with neither, the bot falls back to showing the best matching passage) ---
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# --- Embeddings: default is a free local embedder. To use OpenAI embeddings instead: ---
# EMBEDDINGS=openai
# EMBED_MODEL=text-embedding-3-small

# Only needed if the frontend is hosted on a different domain than the backend
# CORS_ORIGIN=https://your-frontend.example.com
